# @file .env.production.example
# @brief Single-port beta settings. Keep the real .env outside Git and release archives.
NODE_ENV=production
HOST=127.0.0.1
PORT=5180
SITE_URL=https://blog.example.com
DATABASE_URL=postgresql://operator:replace-with-a-secret@database.example.com:5432/blog?sslmode=verify-full
MEDIA_STORAGE=local
MEDIA_DIR=/var/lib/publishing/media
BODY_SIZE_LIMIT=8M
# Password recovery email (all values required together).
RESEND_API_KEY=re_replace-with-server-api-key
PASSWORD_RESET_FROM=BenchCore <account@example.com>
# Trust only an immediate reverse proxy which overwrites X-Forwarded-For.
# Exact IPs only; no arbitrary forwarded chains or client-provided hosts.
TRUSTED_PROXY_IPS=127.0.0.1,::1
