{
	"name": "benchcore",
	"version": "0.8.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"author": "Camiu (https://github.com/camiu01)",
	"type": "module",
	"packageManager": "pnpm@10.15.0",
	"scripts": {
		"dev:frontend": "pnpm --filter benchcore-frontend dev",
		"dev:api": "pnpm --filter benchcore-api dev",
		"demo:api": "pnpm --filter benchcore-api demo",
		"build": "pnpm -r build",
		"build:vercel": "node scripts/build-vercel.mjs",
		"start": "node --env-file-if-exists=.env runtime/server.mjs",
		"beta:migrate": "node --env-file-if-exists=.env api/dist/cli/migrate.js",
		"beta:user:create": "node --env-file-if-exists=.env api/dist/cli/account.js create",
		"user:password": "node --env-file-if-exists=.env api/dist/cli/account.js password",
		"user:totp:reset": "node --env-file-if-exists=.env api/dist/cli/account.js totp-reset",
		"media:cleanup": "pnpm --filter benchcore-api media:cleanup",
		"backup": "pnpm --filter benchcore-api backup",
		"backup:production": "node --env-file-if-exists=.env api/dist/cli/backup.js",
		"media:cleanup:production": "node --env-file-if-exists=.env api/dist/cli/media.js cleanup",
		"beta:package": "node scripts/package-beta.mjs",
		"release:package": "node scripts/package-beta.mjs",
		"release:check": "node scripts/check-release.mjs",
		"check:runtime": "pnpm --filter benchcore-api exec tsc -p ../runtime/tsconfig.json",
		"test": "pnpm -r test",
		"api:spec": "pnpm --filter benchcore-api api:spec",
		"api:spec:check": "pnpm --filter benchcore-api api:spec:check",
		"test:beta": "node scripts/test-beta.mjs",
		"test:bundle": "node scripts/test-beta.mjs --bundle",
		"test:vercel-api": "node scripts/test-vercel-api.mjs",
		"test:e2e": "pnpm --filter benchcore-frontend test:e2e",
		"check": "pnpm -r check && pnpm check:runtime",
		"lint": "pnpm --filter benchcore-frontend lint",
		"format": "pnpm --filter benchcore-frontend format",
		"db:generate": "pnpm --filter benchcore-api db:generate",
		"db:migrate": "pnpm --filter benchcore-api db:migrate",
		"content:import": "pnpm --filter benchcore-api content:import",
		"obsidian:import": "pnpm --filter benchcore-api obsidian:import",
		"seed": "pnpm --filter benchcore-api seed",
		"user:create": "pnpm --filter benchcore-api user:create"
	},
	"devDependencies": {
		"@vercel/backends": "13.0.0"
	}
}
