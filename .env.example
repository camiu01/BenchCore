# Copy to .env and fill in real values. Never commit .env.
# Root reference for both packages (local pnpm and docker compose).

# API service port (local default 5181).
API_PORT="5181"

# Base URL of the API, consumed server-side by the frontend.
# Local: "http://localhost:5181". Docker compose sets http://api:5181 itself.
PUBLIC_API_URL="http://localhost:5181"

# PostgreSQL connection string used by the API via Drizzle (server only).
DATABASE_URL="postgresql://blog:blog@localhost:5432/blog"

# Base URL used for canonical URLs, SEO, RSS and sitemap.
# Local dev: "http://localhost:5173". Docker: "http://localhost:5180".
PUBLIC_SITE_URL="http://localhost:5173"

# Session cookie secret, 32+ random bytes (server only, future signing use).
# Generate with: openssl rand -base64 32
AUTH_SESSION_SECRET="change-me-to-32-plus-random-bytes"

# Admin bootstrap for `pnpm seed` (server only, never exposed to clients).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"
ADMIN_USERNAME="admin"

# Adapter-node upload cap, includes multipart form overhead.
BODY_SIZE_LIMIT="8M"

# Media storage directory for uploads (server only).
# The StorageProvider interface (api/src/media/storage.ts) is the seam for
# future backends; local files live here by default.
MEDIA_DIR="./data/media"

# Media backend: local (filesystem + sidecars) or database (PostgreSQL blobs).
MEDIA_STORAGE="local"

# Exact trusted browser origins for mutating API requests (comma-separated).
# Production requires SITE_URL, PUBLIC_SITE_URL or API_ALLOWED_ORIGINS.
SITE_URL="http://localhost:5173"
API_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5180"

# Content source directory for `pnpm content:import` (defaults to content/posts).
CONTENT_DIR="./content/posts"

# Docker compose PostgreSQL credentials (compose only).
POSTGRES_USER="blog"
POSTGRES_PASSWORD="blog"
POSTGRES_DB="blog"
