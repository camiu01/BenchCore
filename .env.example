# Copy to .env and fill in real values. Never commit .env.
# Root reference for local development; use .env.production.example for Node hosting.

# API service port (local default 5181).
API_PORT="5181"

# Base URL of the API, consumed server-side by the frontend.
# Standalone development API: "http://localhost:5181".
PUBLIC_API_URL="http://localhost:5181"

# PostgreSQL connection string used by the API via Drizzle (server only).
DATABASE_URL="postgresql://blog:blog@localhost:5432/blog"

# Base URL used for canonical URLs, SEO, RSS and sitemap.
# Local development: "http://localhost:5173"; unified preview: "http://localhost:5180".
PUBLIC_SITE_URL="http://localhost:5173"

# Session cookie secret, 32+ random bytes (server only, future signing use).
# Generate with: openssl rand -base64 32
AUTH_SESSION_SECRET="change-me-to-32-plus-random-bytes"

# Admin bootstrap for `pnpm seed` (server only, never exposed to clients).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"
ADMIN_USERNAME="admin"

# Adapter-node upload cap, includes multipart form overhead.
BODY_SIZE_LIMIT="8M"

# Media storage directory for uploads (server only).
# The StorageProvider interface (api/src/media/storage.ts) is the seam for
# future backends; local files live here by default.
MEDIA_DIR="./data/media"

# Media backend: local, database (PostgreSQL blobs), or r2 (private object storage).
MEDIA_STORAGE="local"

# Optional serverless target. See docs/VERCEL_DEPLOYMENT.md for project settings.
# API_SERVICE_URL is injected by Vercel's frontend binding; never set it here.
# DEPLOYMENT_TARGET="vercel"
# SCHEDULER_ENABLED="false"
# R2_ACCOUNT_ID="your-32-character-lowercase-hexadecimal-account-id"
# R2_BUCKET="your-private-media-bucket"
# R2_ACCESS_KEY_ID="replace-with-bucket-scoped-access-key"
# R2_SECRET_ACCESS_KEY="replace-with-private-s3-secret"
# R2_UPLOAD_SECRET="replace-with-independent-random-secret-at-least-32-characters"

# Exact trusted browser origins for mutating API requests (comma-separated).
# Production requires SITE_URL, PUBLIC_SITE_URL or API_ALLOWED_ORIGINS.
SITE_URL="http://localhost:5173"
API_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5180"

# Password recovery email through Resend. Set all three values to enable it.
RESEND_API_KEY="re_replace-with-server-api-key"
PASSWORD_RESET_FROM="BenchCore <account@example.com>"
# Reset links use SITE_URL above as their trusted public origin.

# Content source directory for `pnpm content:import` (defaults to content/posts).
CONTENT_DIR="./content/posts"
