{
	"name": "benchcore-frontend",
	"version": "0.8.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"author": "Camiu (https://github.com/camiu01)",
	"type": "module",
	"packageManager": "pnpm@10.15.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:vercel": "node ../scripts/build-vercel.mjs --frontend-only",
		"start": "node server.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --check .",
		"format:write": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:watch": "vitest"
	},
	"dependencies": {
		"d3-drag": "3.0.1",
		"d3-force": "3.0.1",
		"d3-selection": "3.0.1",
		"d3-zoom": "3.0.1",
		"fflate": "0.8.3",
		"marked": "18.2.1",
		"qrcode": "1.5.4",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-node": "6.0.5",
		"@sveltejs/adapter-vercel": "7.0.5",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/d3-drag": "3.0.7",
		"@types/d3-force": "3.0.10",
		"@types/d3-selection": "3.0.12",
		"@types/d3-zoom": "3.0.9",
		"@types/node": "26.6.6",
		"@types/qrcode": "1.5.6",
		"axe-core": "4.14.1",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"jsqr": "1.4.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"svelte": "5.59.0",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "7.0.2",
		"typescript-eslint": "8.73.0",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	}
}
