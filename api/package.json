{
	"name": "benchcore-api",
	"version": "0.8.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"author": "Camiu (https://github.com/camiu01)",
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
		"dev:vercel": "tsx scripts/dev-vercel.ts",
		"demo": "tsx scripts/demo.ts",
		"media:cleanup": "tsx --env-file-if-exists=../.env src/cli/media.ts cleanup",
		"backup": "tsx --env-file-if-exists=../.env src/cli/backup.ts",
		"build": "tsc -p tsconfig.build.json",
		"build:vercel": "tsc -p tsconfig.build.json --noEmit && node scripts/build-vercel.mjs",
		"start": "node dist/index.js",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"api:spec": "tsx scripts/generate-openapi.ts",
		"api:spec:check": "vitest run tests/openapi.test.ts tests/openapi-wire.test.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=../.env scripts/migrate.ts",
		"content:import": "tsx --env-file-if-exists=../.env scripts/import.ts",
		"obsidian:import": "tsx --env-file-if-exists=../.env scripts/import-obsidian.ts",
		"seed": "tsx --env-file-if-exists=../.env scripts/seed.ts",
		"user:create": "tsx --env-file-if-exists=../.env scripts/create-user.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1146.0",
		"@aws-sdk/s3-request-presigner": "3.1146.0",
		"drizzle-orm": "0.45.3",
		"katex": "0.16.22",
		"marked": "18.0.14",
		"nodemailer": "10.0.12",
		"postgres": "3.4.9",
		"sanitize-html": "2.18.0",
		"smol-toml": "1.9.0",
		"yaml": "2.8.2",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@apidevtools/swagger-parser": "12.1.0",
		"@types/katex": "0.16.7",
		"@types/node": "26.6.3",
		"@types/sanitize-html": "2.16.2",
		"drizzle-kit": "0.31.11",
		"esbuild": "0.27.7",
		"tsx": "4.23.15",
		"typescript": "5.9.2",
		"vitest": "5.0.3"
	}
}
