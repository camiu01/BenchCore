{
	"name": "blog-api",
	"version": "0.1.0",
	"private": true,
	"license": "GPL-3.0-only",
	"author": "Camiu (https://github.com/camiu01)",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"content:import": "tsx scripts/import.ts",
		"seed": "tsx scripts/seed.ts"
	},
	"dependencies": {
		"drizzle-orm": "0.45.3",
		"marked": "18.0.14",
		"postgres": "3.4.9",
		"sanitize-html": "2.18.0",
		"smol-toml": "1.9.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@types/node": "26.6.3",
		"@types/sanitize-html": "2.16.2",
		"drizzle-kit": "0.31.11",
		"tsx": "4.23.15",
		"typescript": "5.9.2",
		"vitest": "5.0.3"
	}
}
