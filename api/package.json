{
	"name": "benchcore-api",
	"version": "0.6.0-beta.1",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"author": "Camiu (https://github.com/camiu01)",
	"type": "module",
	"scripts": {
		"dev": "tsx --env-file-if-exists=../.env watch src/index.ts",
		"dev:vercel": "tsx scripts/dev-vercel.ts",
		"demo": "tsx scripts/demo.ts",
		"build": "tsc -p tsconfig.build.json",
		"build:vercel": "tsc -p tsconfig.build.json --noEmit && node scripts/build-vercel.mjs",
		"start": "node dist/index.js",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=../.env scripts/migrate.ts",
		"content:import": "tsx --env-file-if-exists=../.env scripts/import.ts",
		"seed": "tsx --env-file-if-exists=../.env scripts/seed.ts",
		"user:create": "tsx --env-file-if-exists=../.env scripts/create-user.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1146.0",
		"@aws-sdk/s3-request-presigner": "3.1146.0",
		"drizzle-orm": "0.45.3",
		"marked": "18.0.14",
		"nodemailer": "10.0.12",
		"postgres": "3.4.9",
		"sanitize-html": "2.18.0",
		"smol-toml": "1.9.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@types/node": "26.6.3",
		"@types/sanitize-html": "2.16.2",
		"drizzle-kit": "0.31.11",
		"esbuild": "0.27.7",
		"tsx": "4.23.15",
		"typescript": "5.9.2",
		"vitest": "5.0.3"
	}
}
